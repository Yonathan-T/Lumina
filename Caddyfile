:{$PORT:80} {
    root * /app/public
    encode zstd gzip

    @static {
        path /build/* /vendor/livewire/* /audio/* *.css *.js *.svg *.ico *.woff2 *.png *.jpg *.webp *.m4a *.mp3 *.ogg
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    php_server {
        try_files {path} index.php
    }
}
