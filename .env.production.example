# =========================================================================
# Lumina — production environment template
# Copy the values you need into your host's dashboard (Render/Fly/Railway).
# Keys verified against config/*.php. Do NOT commit real secrets.
# =========================================================================

# --- Core ---------------------------------------------------------------
APP_NAME=Lumina
APP_ENV=production
APP_DEBUG=false
# Generate locally with: php artisan key:generate --show
APP_KEY=
# Your public URL, e.g. https://lumina.onrender.com  (no trailing slash)
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Log to stderr so the host's log stream captures it
LOG_CHANNEL=stderr
LOG_LEVEL=error

# --- Database (managed Postgres) ----------------------------------------
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=lumina
DB_USERNAME=
DB_PASSWORD=

# --- Session / cache / queue (DB-backed) --------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- AI provider --------------------------------------------------------
# AI_PROVIDER is one of: huggingface | openai | gemini
AI_PROVIDER=huggingface
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- ElevenLabs (text-to-speech) ----------------------------------------
ELEVENLABS_API_KEY=

# --- Mail (pick an SMTP provider; log driver won't send real mail) ------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Polar billing ------------------------------------------------------
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_STANDARD_PRODUCT_ID=
POLAR_PRO_PRODUCT_ID=

# --- Social login (Socialite) -------------------------------------------
# Redirect URIs must match {APP_URL}/auth/{provider}/callback in your app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
GITHUB_WEBHOOK_SECRET=

# --- Web push notifications (VAPID) -------------------------------------
# Generate a keypair with: php artisan webpush:vapid
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Storage ------------------------------------------------------------
# NOTE: free-tier disks are EPHEMERAL — uploaded files and PDF exports are
# wiped on every redeploy/restart. Use S3 (or a Render persistent disk) for
# anything users must keep. `local` is fine only for throwaway data.
FILESYSTEM_DISK=local
